# =============================================================================
# News Website Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED VARIABLES
# These variables are validated at startup. The application will fail to start
# if any of these are missing.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas)
# -----------------------------------------------------------------------------
# MongoDB connection string from MongoDB Atlas.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# IMPORTANT: URL-encode special characters in your password (@ → %40, : → %3A, / → %2F)
MONGODB_URI=mongodb+srv://user:<password>@cluster.x.mongodb.net/news-website?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Authentication (NextAuth v5)
# -----------------------------------------------------------------------------
# Random secret for signing NextAuth sessions.
# Generate with: openssl rand -hex 32
# WARNING: Changing this invalidates all existing sessions.
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_HEX_STRING

# Base URL of the site — used by NextAuth v5 to validate the request host.
# This is the variable @auth/core checks to auto-enable trustHost.
# Format: http://localhost:3000 (development) or https://your-domain.com (production)
# IMPORTANT: Do NOT include a trailing slash.
AUTH_URL=http://localhost:3000

# Admin credentials for built-in credentials provider.
# These are used to create the initial admin account.
# For production, use a strong password (16+ characters, mixed case, numbers, symbols).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Cloudinary (Media Upload)
# -----------------------------------------------------------------------------
# Cloudinary credentials for image/video upload functionality.
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# OPTIONAL VARIABLES
# These variables are feature-specific. The application will start without them,
# but the corresponding features will be disabled gracefully.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AI / Gemini (Content Generation)
# -----------------------------------------------------------------------------
# Google Gemini API key for AI-powered content generation.
# Get this from: https://aistudio.google.com
# If missing, AI content generation features will be disabled.
GEMINI_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# News API (External News Import)
# -----------------------------------------------------------------------------
# API key for external news import functionality.
# Get this from: https://newsapi.org (or use GNews/MediaStack for production)
# Note: NewsAPI free plan only works on localhost. Use GNews for production.
# If missing, external news import will be disabled.
NEWS_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Public / Site Configuration
# -----------------------------------------------------------------------------
# Base URL of the site (used for SEO meta tags, sitemaps, canonical URLs).
# If not set, defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Public Cloudinary Reference
# -----------------------------------------------------------------------------
# Cloudinary cloud name for client-side image URL construction.
# Allows frontend code to build Cloudinary image URLs (e.g., for optimization).
# Typically the same as CLOUDINARY_CLOUD_NAME.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME

# -----------------------------------------------------------------------------
# Unsigned Upload Preset (Optional)
# -----------------------------------------------------------------------------
# Cloudinary upload preset for unsigned uploads (client-side only).
# Create an unsigned preset in: Cloudinary Dashboard → Settings → Upload → Upload Presets
# If not set, uploads must go through the server-side API route.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=CHANGE_ME
